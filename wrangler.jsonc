// Publicação na Cloudflare (ADR-0001): os arquivos de dist/ são servidos direto, sem passar
// pelo Worker e sem contar no limite gratuito de requisições; só /api e /api/* executam código.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cesta-certa",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público em <nome>.<subdomínio da conta>.workers.dev e um link de prévia por
  // versão enviada de outra branch, fixados aqui para nenhum deploy desligar.
  "workers_dev": true,
  "preview_urls": true,
  // Limite por cliente da consulta da nota (ADR-0001): 10 por minuto, contado pela própria
  // Cloudflare em cada local da rede. Só para /api; as páginas nem passam pelo Worker.
  "ratelimits": [
    { "name": "LIMITE_DA_NOTA", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
  ],
  // Contadores de uso do assistente (ADR-0004): sem `database_id` de propósito. No primeiro
  // deploy, o wrangler acha o banco pelo nome ou cria (o token do build tem D1 Edit desde
  // 2026-11-13) e liga ao Worker; depois o binding é herdado. Localmente, o `wrangler dev` cria
  // um banco vazio em .wrangler/.
  "d1_databases": [{ "binding": "USO_ASSISTENTE", "database_name": "cesta-certa-uso" }],
  // O build de prévia de cada PR roda `wrangler preview`, que exige este bloco. A prévia usa o
  // mesmo código; binding não passa de um bloco para o outro, então o limite se repete aqui,
  // com contador próprio. Sem D1 por enquanto: o `wrangler preview` não cria banco e precisa
  // de um que já exista; até o primeiro deploy da main criar o banco, o assistente da prévia
  // responde "indisponível" (ADR-0004).
  "previews": {
    "ratelimits": [
      { "name": "LIMITE_DA_NOTA", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api", "/api/*"],
  },
  // Logs do Worker (gratuitos, retenção curta). O Worker só registra metadados técnicos
  // (worker/observabilidade/registro.ts); a query string fica fora por garantia.
  "observability": { "enabled": true, "redact_query_string": true },
}
