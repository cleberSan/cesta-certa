// Publicação na Cloudflare (ADR-0001): os arquivos de dist/ são servidos direto, sem passar
// pelo Worker e sem contar no limite gratuito de requisições; só /api e /api/* executam código.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cesta-certa",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Endereço público em <nome>.<subdomínio da conta>.workers.dev e um link de prévia por
  // versão enviada de outra branch, fixados aqui para nenhum deploy desligar.
  "workers_dev": true,
  "preview_urls": true,
  // O build de prévia de cada PR roda `wrangler preview`, que exige este bloco. Vazio: a
  // prévia usa o mesmo código e não tem binding nem variável própria.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api", "/api/*"],
  },
  // Logs do Worker (gratuitos, retenção curta). O Worker só registra metadados técnicos
  // (worker/observabilidade/registro.ts); a query string fica fora por garantia.
  "observability": { "enabled": true, "redact_query_string": true },
}
