---
import { repositoryUrl, siteName } from "../config/site";
import ExternalLink from "./ExternalLink.astro";

/** Rodapé com Seus dados, Privacidade e Sobre em toda página (spec 0002, CA-04). */
---

<footer class="rodape">
  <div class="rodape-conteudo">
    <p>{siteName}: projeto de código aberto, sem anúncio e sem rastreador.</p>
    <ul>
      <li>
        <a href="/dados">Seus dados</a>
      </li>
      <li>
        <a href="/privacidade">Privacidade</a>
      </li>
      <li>
        <a href="/sobre">Sobre</a>
      </li>
      <li>
        <ExternalLink href={repositoryUrl}>Código no GitHub</ExternalLink>
      </li>
    </ul>
  </div>
</footer>

<style>
  .rodape {
    margin-top: 2rem;
    border-top: 1px solid var(--cor-borda);
    background: var(--cor-superficie);
    color: var(--cor-texto-suave);
    font-size: 0.95rem;
  }

  .rodape-conteudo {
    max-width: var(--largura-larga);
    margin: 0 auto;
    padding: 1rem var(--espaco);
  }

  p {
    margin: 0 0 0.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 0;
  }

  ul :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .rodape-conteudo {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
    }

    p {
      margin: 0;
    }
  }
</style>
