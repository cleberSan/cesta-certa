---
import { publicPath, siteName } from "../config/site";

const current = publicPath(Astro.url.pathname);
const links = [
  { href: "/", label: "Início" },
  { href: "/lista", label: "Lista" },
  { href: "/mercados", label: "Mercados" },
  { href: "/nota", label: "Testar nota" },
  { href: "/sobre", label: "Sobre" },
];
---

<header class="topo">
  <div class="topo-conteudo">
    <a class="marca" href="/">
      <img src="/icone.svg" alt="" width="32" height="32" />
      <span>{siteName}</span>
    </a>
    <nav aria-label="Principal">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .topo {
    background: var(--cor-superficie);
    border-bottom: 1px solid var(--cor-borda);
  }

  .topo-conteudo {
    max-width: var(--largura-conteudo);
    margin: 0 auto;
    padding: 0.5rem var(--espaco);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--cor-texto);
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
  }

  .marca img {
    border-radius: 0.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 0;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: var(--raio-pilula);
    color: var(--cor-texto);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  nav a[aria-current="page"] {
    background: var(--cor-marca);
    color: var(--cor-sobre-marca);
  }
</style>
